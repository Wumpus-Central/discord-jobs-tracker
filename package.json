{
  "name": "discord-jobs-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Discord jobs tracker",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
